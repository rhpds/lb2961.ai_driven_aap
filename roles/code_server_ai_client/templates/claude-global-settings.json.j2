{
  "env": {
    "ANTHROPIC_BASE_URL": "{{ _claude_base_url | trim }}",
    "ANTHROPIC_API_KEY": "{{ _claude_api_key | trim }}",
    "ANTHROPIC_MODEL": "{{ claude_code_model }}",
    "DISABLE_UPDATES": "1"
  },
  "permissions": {
    "allow": [
      "Bash(git:*)",
      "Bash(ansible-navigator:*)",
      "Bash(ansible-playbook:*)",
      "Bash(ansible-lint:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(pwd:*)",
      "Bash(cd:*)"
    ]
  },
  "model": "{{ claude_code_model }}"
}
